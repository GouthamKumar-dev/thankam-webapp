    "fix-units": "ts-node scripts/fix-units.ts",
    "fix-units:dry": "ts-node scripts/fix-units.ts --dry-run",
    "deploy": "npm run prisma:deploy && npm run fix-units && npm run start"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
