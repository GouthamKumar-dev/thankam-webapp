NODE_ENV=development

# Server
API_PORT=4000
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/thankam_events?schema=public"

# JWT
JWT_ACCESS_SECRET="change_me_access"
JWT_REFRESH_SECRET="change_me_refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"
CUSTOMER_PORTAL_JWT_SECRET="change_me_customer_portal"
CUSTOMER_PORTAL_JWT_EXPIRES="7d"

# Security
BCRYPT_ROUNDS=12

# MSG91 — https://control.msg91.com/
MSG91_AUTH_KEY=""
# 6-char DLT-registered sender header e.g. THNKEV (get from MSG91 → SMS → Sender IDs)
MSG91_SMS_SENDER_ID=""
# OTP template ID from MSG91 dashboard (not DLT template ID)
MSG91_SMS_OTP_TEMPLATE_ID=""
MSG91_FROM_EMAIL="no-reply@thankamevents.in"
MSG91_FROM_NAME="Thankam Events"

# File uploads
UPLOAD_LOCAL_DIR="uploads"
# Per-file media size accepted by Nest/Multer. Set the reverse proxy request limit above this value.
UPLOAD_MAX_FILE_SIZE_MB=50

# Business
GST_PERCENT_DEFAULT=5
